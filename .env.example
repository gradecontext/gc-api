# ContextGrade — Environment Configuration
#
# Environment isolation strategy:
#   .env          → local development (default, loaded automatically)
#   .env.sandbox  → sandbox Supabase instance (sandbox.contextgrade.com)
#   .env.prod     → production Supabase instance (api.contextgrade.com)
#
# Usage with dotenv-cli:
#   npx dotenv -e .env.sandbox -- npx prisma migrate dev --name my_migration
#   npx dotenv -e .env.prod    -- npx prisma migrate deploy
#
# Or use the npm scripts:
#   npm run db:migrate:sandbox -- --name my_migration
#   npm run db:migrate:prod

# Server Configuration
PORT=8080
NODE_ENV=development
HOST=0.0.0.0

# Database (Supabase Postgres)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/contextgrade?sslmode=require

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_your-publishable-key-here
# Secret key (optional in development — required for user auth features)
# SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# AI Service
# Provide at least one of the following:
OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Authentication (API Key for V1)
# In development, this can be omitted (auth will be skipped)
API_KEY=your-api-key-here

# Stripe (subscription billing — optional; /billing/* routes and the
# /webhooks/stripe endpoint return a clear "Not Configured" error until set)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret-here
STRIPE_GROWTH_MONTHLY_PRICE_ID=price_your-growth-monthly-price-id
STRIPE_GROWTH_ANNUAL_PRICE_ID=price_your-growth-annual-price-id
STRIPE_SCALE_MONTHLY_PRICE_ID=price_your-scale-monthly-price-id
STRIPE_SCALE_ANNUAL_PRICE_ID=price_your-scale-annual-price-id

# Logging
LOG_LEVEL=info
