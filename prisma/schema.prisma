// ContextGrade — Decision Intelligence Schema
// Multi-client decision trace store and context graph foundation
// "Decision intelligence for onboarding, pricing, and trust."

// Node.js — binary engine for local dev (tsx watch)
generator client {
  provider = "prisma-client-js"
}

// Cloudflare Workers — WASM engine for edge deployment
generator worker {
  provider = "prisma-client"
  runtime  = "cloudflare"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PLATFORM ADMINISTRATION
// ============================================================

// Admins are ContextGrade platform operators — internal staff who
// manage clients, review leads, and oversee the system.
model Admin {
  id          Int         @id @default(autoincrement())
  fullName    String      @map("full_name") @db.Text
  email       String      @unique @db.Text
  active      Boolean     @default(true)
  accessLevel AccessLevel @default(STAFF) @map("access_level")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  leads            Lead[]
  contactsHandled  ContactMessage[] @relation("ContactHandledBy")
  betaApprovals    BetaAccessList[] @relation("BetaApprovedBy")

  @@map("admins")
}

enum AccessLevel {
  SUPER_ADMIN
  STAFF
  DEVELOPER

  @@map("access_level")
}

// ============================================================
// LEAD GENERATION
// ============================================================

// Leads capture inbound interest before they become clients/users.
// Tracks the full lifecycle from initial contact to conversion.
model Lead {
  id                 Int         @id @default(autoincrement())
  email              String      @db.Text
  fullName           String?     @map("full_name") @db.Text
  companyName        String?     @map("company_name") @db.Text
  companySize        String?     @map("company_size") @db.Text
  companyWebsite     String?     @map("company_website") @db.Text
  planInterest       ClientPlan? @map("plan_interest")
  source             String?     @db.Text
  message            String?     @db.Text
  contacted          Boolean     @default(false)
  status             LeadStatus  @default(NEW)
  convertedToUserId  Int?        @map("converted_to_user_id")
  convertedToClientId Int?       @map("converted_to_client_id")
  representedBy      Int?        @map("represented_by")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  convertedUser   User?   @relation(fields: [convertedToUserId], references: [id], onDelete: SetNull)
  convertedClient Client? @relation("LeadConvertedClient", fields: [convertedToClientId], references: [id], onDelete: SetNull)
  representedByAdmin Admin? @relation(fields: [representedBy], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([representedBy])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  PENDING
  APPROVED
  REJECTED
  CONVERTED

  @@map("lead_status")
}

// ============================================================
// CORE ENTITIES
// ============================================================

// Clients are ContextGrade's direct customers — the B2B companies
// that integrate ContextGrade into their onboarding/billing workflows.
// e.g., "ACME Corp" (GPU seller using ContextGrade)
model Client {
  id              Int        @id @default(autoincrement())
  name            String
  slug            String     @unique
  domain          String?
  apiKey          String?    @unique @map("api_key")
  webhookSecret   String?    @map("webhook_secret")
  plan            ClientPlan @default(FREE)
  active          Boolean    @default(true)
  verified        Boolean    @default(false)
  approved        Boolean    @default(false)
  details         String?    @db.Text
  logo            String?    @db.Text
  coverImage      String?    @map("cover_image") @db.Text
  clientWebsite   String?    @map("client_website") @db.Text
  clientX         String?    @map("client_x") @db.Text
  clientLinkedin  String?    @map("client_linkedin") @db.Text
  clientInstagram String?    @map("client_instagram") @db.Text
  settings        Json?      @default("{}") // Client-level config (thresholds, preferences)
  addedBy         Int?       @map("added_by")
  modifiedBy      Int?       @map("modified_by")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  addedByUser      User?        @relation("ClientAddedBy", fields: [addedBy], references: [id], onDelete: SetNull)
  modifiedByUser   User?        @relation("ClientModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  memberships         Membership[]
  subjectCompanies    SubjectCompany[]
  decisions           Decision[]
  policies            Policy[]
  webhookEvents       WebhookEvent[]
  convertedLeads      Lead[]             @relation("LeadConvertedClient")
  observedEvents          ObservedEvent[]
  sourceApplications      SourceApplication[]
  clientDecisionTypes     ClientDecisionType[]
  clientContextCategories ClientContextCategory[]
  aiDecisionReports       AIDecisionReport[]

  @@index([slug])
  @@index([addedBy])
  @@index([modifiedBy])
  @@map("clients")
}

enum ClientPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE

  @@map("client_plan")
}

// Users are identity records — a person who can belong to one or more
// organizations (Clients) through the Membership join table.
// supabaseAuthId links to Supabase auth.users for authentication.
model User {
  id              Int      @id @default(autoincrement())
  supabaseAuthId  String?  @unique @map("supabase_auth_id") @db.Uuid
  email           String   @unique
  name            String?
  title           String?
  active          Boolean  @default(true)
  verified        Boolean  @default(true)
  displayName     String?  @map("display_name") @db.VarChar(150)
  userName        String?  @unique @map("user_name") @db.VarChar(100)
  imageUrl        String?  @map("image_url")
  userImage       String?  @map("user_image") @db.Text
  userImageCover  String?  @map("user_image_cover") @db.Text
  userBioDetail   String?  @map("user_bio_detail") @db.Text
  userBioBrief    String?  @map("user_bio_brief") @db.VarChar(255)
  gender          Gender?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships       Membership[]
  notifications     Notification[]
  clientsAdded      Client[]                @relation("ClientAddedBy")
  clientsModified   Client[]                @relation("ClientModifiedBy")
  decisionsMade     Decision[]              @relation("DecisionMaker")
  decisionsLogged   Decision[]              @relation("DecisionLogger")
  decisionOverrides DecisionHumanOverride[]
  decisionOutcomes  DecisionOutcome[]
  convertedLeads    Lead[]
  observedEvents    ObservedEvent[]
  decisionNotes     DecisionNote[]
  aiReportsTriggered AIDecisionReport[]

  @@index([supabaseAuthId])
  @@map("users")
}

enum UserRole {
  ADMIN
  STAFF
  @@map("user_role")
}

// ============================================================
// MEMBERSHIP (User ↔ Client join table)
// ============================================================

// Memberships link users to organizations and track per-org role and approval status.
// First user to create a company gets ADMIN + ACTIVE; subsequent joiners are STAFF + PENDING
// until approved by an admin (or auto-approved via domain matching). Admins can later
// promote a STAFF membership to ADMIN (or demote, as long as one ADMIN remains).
model Membership {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  clientId  Int              @map("client_id")
  role      UserRole         @default(STAFF)
  status    MembershipStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
  @@index([clientId, status])
  @@map("memberships")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED

  @@map("membership_status")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

// In-app notifications for membership requests, approvals, and system events.
// Displayed on the user's dashboard with a read/unread flag.
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType
  title     String           @db.VarChar(255)
  message   String           @db.Text
  metadata  Json?            @default("{}")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  MEMBERSHIP_REQUEST
  MEMBERSHIP_APPROVED
  MEMBERSHIP_REJECTED
  SYSTEM

  @@map("notification_type")
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  GENDERQUEER
  GENDERFLUID
  AGENDER
  BIGENDER
  TWO_SPIRIT
  TRANSGENDER_MALE
  TRANSGENDER_FEMALE
  INTERSEX
  PREFER_NOT_TO_SAY
  OTHER

  @@map("gender")
}

// SubjectCompanies are the entities being evaluated — the client's leads/prospects.
// e.g., "ABC Corp" (a company wanting to buy GPUs from ACME Corp)
// Every webhook payload references a SubjectCompany via externalId.
model SubjectCompany {
  id         Int          @id @default(autoincrement())
  clientId   Int          @map("client_id")
  externalId String       @map("external_id") // Client's CRM/system identifier for this company
  name       String
  domain     String?
  industry   String?
  country    String?
  size       CompanySize?
  active     Boolean      @default(true)
  metadata   Json?        @default("{}") // Flexible extra data from CRM (address, tags, etc.)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deals     Deal[]
  decisions Decision[]

  @@unique([clientId, externalId])
  @@index([clientId])
  @@index([externalId])
  @@index([clientId, domain])
  @@map("subject_companies")
}

enum CompanySize {
  MICRO // 1-10 employees
  SMALL // 11-50 employees
  MEDIUM // 51-200 employees
  LARGE // 201-1000 employees
  ENTERPRISE // 1001-5000 employees
  MEGA // 5000+ employees

  @@map("company_size")
}

// Deals anchor decisions to revenue context (optional but recommended).
model Deal {
  id                String     @id @default(uuid()) @db.Uuid
  subjectCompanyId  Int        @map("subject_company_id")
  crmDealId         String?    @map("crm_deal_id") // Salesforce / HubSpot ID
  amount            Decimal?   @db.Decimal(19, 2)
  currency          String?    @default("USD") @db.VarChar(3)
  discountRequested Decimal?   @map("discount_requested") @db.Decimal(5, 2)
  stage             DealStage? @default(OPEN)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  subjectCompany SubjectCompany @relation(fields: [subjectCompanyId], references: [id], onDelete: Cascade)
  decisions      Decision[]

  @@index([subjectCompanyId])
  @@index([crmDealId])
  @@map("deals")
}

enum DealStage {
  OPEN
  WON
  LOST
  STALLED

  @@map("deal_stage")
}

// ============================================================
// DECISION CONTEXT DOMAINS
// ============================================================

// ============================================================
// DECISION SYSTEM (THIS IS MY MOAT)
// ============================================================

// Decisions are the atomic unit of truth — immutable events.
// Every decision is anchored to a client, a subject company,
// a decision type, and a context category (the domain it belongs to).
model Decision {
  id                    String              @id @default(uuid()) @db.Uuid
  clientId              Int                 @map("client_id")
  subjectCompanyId      Int?                @map("subject_company_id")
  dealId                String?             @map("deal_id") @db.Uuid
  contextCategoryId     String              @map("context_category_id") @db.Uuid
  decisionTypeId        String              @map("decision_type_id") @db.Uuid
  status                DecisionStatus      @default(PROPOSED)
  urgency               DecisionUrgency     @default(NORMAL)
  summary               String?             // Human-readable title, e.g. "Acme Corp Discount Request"
  recommendedAction     String?             @map("recommended_action")
  recommendedConfidence DecisionConfidence? @map("recommended_confidence")
  suggestedConditions   Json?               @map("suggested_conditions") // ["Require upfront payment", "Limit discount to 10%"]
  finalAction           String?             @map("final_action")
  decidedBy             Int?                @map("decided_by")
  loggedBy              Int?                @map("logged_by") // who captured this decision (extension/API caller) — distinct from decidedBy (who reviewed it)
  expiresAt             DateTime?           @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  decidedAt             DateTime?           @map("decided_at") @db.Timestamptz(6)

  client             Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientDecisionType ClientDecisionType       @relation(fields: [decisionTypeId], references: [id])
  subjectCompany     SubjectCompany?          @relation(fields: [subjectCompanyId], references: [id])
  deal               Deal?                    @relation(fields: [dealId], references: [id])
  contextCategory    ClientContextCategory    @relation(fields: [contextCategoryId], references: [id])
  decisionMaker      User?                    @relation("DecisionMaker", fields: [decidedBy], references: [id])
  loggedByUser       User?                    @relation("DecisionLogger", fields: [loggedBy], references: [id], onDelete: SetNull)
  contextSnapshot DecisionContextSnapshot?
  humanOverrides  DecisionHumanOverride[]
  outcomes        DecisionOutcome[]
  linksAsSource   DecisionLink[]           @relation("SourceDecision")
  linksAsTarget   DecisionLink[]           @relation("TargetDecision")
  externalSources ExternalSource[]
  notes           DecisionNote[]
  entities        DecisionEntity[]
  observedEvents  ObservedEvent[]

  @@index([clientId])
  @@index([subjectCompanyId])
  @@index([clientId, status])
  @@index([clientId, decisionTypeId])
  @@index([clientId, contextCategoryId])
  @@index([clientId, loggedBy])
  @@index([createdAt])
  @@map("decisions")
}

enum DecisionStatus {
  PROPOSED
  PENDING_REVIEW
  APPROVED
  REJECTED
  OVERRIDDEN
  EXPIRED
  ESCALATED

  @@map("decision_status")
}

enum DecisionConfidence {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH

  @@map("decision_confidence")
}

enum DecisionUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL

  @@map("decision_urgency")
}

// ============================================================
// DECISION TRACE COMPONENTS
// ============================================================

// Context snapshots capture the world state at decision time.
// This is your time-travel capability:
// "What did the world look like when this decision was made?"
model DecisionContextSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  decisionId       String   @unique @map("decision_id") @db.Uuid
  signals          Json // Raw signals used by the agent
  policies         Json? // Policies evaluated (even informal ones)
  agentRationale   String?  @map("agent_rationale") @db.Text
  agentModel       String?  @map("agent_model") // Which AI model produced this
  processingTimeMs Int?     @map("processing_time_ms") // How long context gathering took
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@map("decision_context_snapshots")
}

// Human overrides capture judgment — this is gold for learning and trust calibration.
model DecisionHumanOverride {
  id             String         @id @default(uuid()) @db.Uuid
  decisionId     String         @map("decision_id") @db.Uuid
  userId         Int            @map("user_id")
  overrideAction OverrideAction @map("override_action")
  overrideReason String?        @map("override_reason") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([decisionId])
  @@index([userId])
  @@map("decision_human_overrides")
}

enum OverrideAction {
  APPROVED
  REJECTED
  ESCALATED
  MODIFIED

  @@map("override_action")
}

// Decision outcomes track what actually happened — the feedback loop.
// This is how you eventually answer: "Which decisions were actually good?"
model DecisionOutcome {
  id          String      @id @default(uuid()) @db.Uuid
  decisionId  String      @map("decision_id") @db.Uuid
  userId      Int?        @map("user_id")
  outcomeType OutcomeType @map("outcome_type")
  notes       String?     @db.Text
  recordedAt  DateTime    @default(now()) @map("recorded_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([decisionId])
  @@index([outcomeType])
  @@map("decision_outcomes")
}

enum OutcomeType {
  PAID_ON_TIME
  PAID_LATE
  CHURNED
  FRAUD
  EXPANDED
  DOWNGRADED
  DEFAULTED
  POSITIVE
  NEGATIVE
  NEUTRAL

  @@map("outcome_type")
}

// ============================================================
// CONTEXT GRAPH & PRECEDENT (SECRET WEAPON)
// ============================================================

// Decision links form the context graph — precedent, similarity, contradiction.
// This becomes your "case law" system. No Neo4j needed on day one.
model DecisionLink {
  id               String           @id @default(uuid()) @db.Uuid
  fromDecisionId   String           @map("from_decision_id") @db.Uuid
  toDecisionId     String           @map("to_decision_id") @db.Uuid
  relationshipType RelationshipType @map("relationship_type")
  confidence       Decimal?         @db.Decimal(3, 2) // 0.00 to 1.00 similarity score
  notes            String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceDecision Decision @relation("SourceDecision", fields: [fromDecisionId], references: [id], onDelete: Cascade)
  targetDecision Decision @relation("TargetDecision", fields: [toDecisionId], references: [id], onDelete: Cascade)

  @@unique([fromDecisionId, toDecisionId, relationshipType])
  @@index([fromDecisionId])
  @@index([toDecisionId])
  @@map("decision_links")
}

enum RelationshipType {
  PRECEDENT
  SIMILAR_CASE
  POLICY_EXCEPTION
  CONTRADICTS
  SUPPORTS
  FOLLOW_UP

  @@map("relationship_type")
}

// ============================================================
// SIGNAL SOURCING & AUDIT
// ============================================================

// External sources track where signals came from — full auditability.
model ExternalSource {
  id          String     @id @default(uuid()) @db.Uuid
  decisionId  String     @map("decision_id") @db.Uuid
  sourceType  SourceType @map("source_type")
  sourceUrl   String?    @map("source_url")
  rawData     Json?      @map("raw_data") // The actual scraped/fetched content snapshot
  reliability Decimal?   @db.Decimal(3, 2) // 0.00 to 1.00 source reliability score
  extractedAt DateTime   @default(now()) @map("extracted_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([sourceType])
  @@map("external_sources")
}

enum SourceType {
  REDDIT
  TWITTER
  G2
  TRUSTPILOT
  NEWS
  GOOGLE_SEARCH
  WEBSITE
  LINKEDIN
  CRUNCHBASE
  COURT_RECORDS
  FINANCIAL_FILINGS
  GLASSDOOR
  GITHUB
  CUSTOM

  @@map("source_type")
}

// ============================================================
// POLICIES & RULES
// ============================================================

// Policies structure decision rules — even informal ones deserve structure.
// Versioned so you can track policy evolution over time.
model Policy {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    Int      @map("client_id")
  name        String
  description String?  @db.Text
  rules       Json? // Structured policy rules (conditions, thresholds, etc.)
  version     Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, active])
  @@map("policies")
}

// ============================================================
// WEBHOOK INGESTION
// ============================================================

// WebhookEvent tracks every incoming webhook for idempotency, debugging, and replay.
// This is critical for a system that sits in the execution path.
model WebhookEvent {
  id              String             @id @default(uuid()) @db.Uuid
  clientId        Int                @map("client_id")
  externalEventId String?            @unique @map("external_event_id") // Idempotency key
  eventType       WebhookEventType   @map("event_type")
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(6)
  error           String?            @db.Text
  retryCount      Int                @default(0) @map("retry_count")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([externalEventId])
  @@map("webhook_events")
}

enum WebhookEventType {
  COMPANY_CREATED
  COMPANY_UPDATED
  DEAL_CREATED
  DEAL_UPDATED
  DISCOUNT_REQUESTED

  @@map("webhook_event_type")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED

  @@map("webhook_event_status")
}

// ============================================================
// CONTACT US
// ============================================================

// Captures inbound "Contact Us" form submissions from the public site.
// Admins can mark messages as responded and track who handled them.
model ContactMessage {
  id          Int                  @id @default(autoincrement())
  name        String               @db.Text
  email       String               @db.Text
  phone       String?              @db.Text
  subject     String               @db.Text
  message     String               @db.Text
  source      String?              @db.Text
  status      ContactMessageStatus @default(NEW)
  priority    ContactPriority      @default(NORMAL)
  contactedBy Int?                 @map("contacted_by")
  respondedAt DateTime?            @map("responded_at") @db.Timestamptz(6)
  ipAddress   String?              @map("ip_address") @db.VarChar(45)
  userAgent   String?              @map("user_agent") @db.Text
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  contactedByAdmin Admin? @relation("ContactHandledBy", fields: [contactedBy], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([contactedBy])
  @@index([createdAt])
  @@map("contact_messages")
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
  SPAM

  @@map("contact_message_status")
}

enum ContactPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("contact_priority")
}

// ============================================================
// BETA ACCESS LIST
// ============================================================

// Interim waitlist for beta program access. Tracks who applied,
// whether they've been approved, and by which admin.
model BetaAccessList {
  id                   Int         @id @default(autoincrement())
  fullName             String      @map("full_name") @db.Text
  email                String      @unique @db.Text
  companyName          String?     @map("company_name") @db.Text
  numberOfUsersRange   String?     @map("number_of_users_range") @db.Text
  source               String?     @db.Text
  planInterest         ClientPlan? @map("plan_interest")
  allowAccess          Boolean     @default(false) @map("allow_access")
  approvedBy           Int?        @map("approved_by")
  approvedAt           DateTime?   @map("approved_at") @db.Timestamptz(6)
  notes                String?     @db.Text
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  approvedByAdmin Admin? @relation("BetaApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([allowAccess])
  @@index([approvedBy])
  @@map("beta_access_list")
}

// ============================================================
// BROWSER EXTENSION LAYER
// ============================================================

// SourceApplication is the registry of apps the extension monitors.
// Client-configurable so each team defines which tools to track.
// e.g., "Jira", "Figma", "Salesforce", "HubSpot"
model SourceApplication {
  id            String   @id @default(uuid()) @db.Uuid
  clientId      Int      @map("client_id")
  name          String   @db.Text
  slug          String   @db.VarChar(100)
  domainPattern String?  @map("domain_pattern") @db.Text
  active        Boolean  @default(true)
  settings      Json?    @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  observedEvents ObservedEvent[]

  @@unique([clientId, slug])
  @@index([clientId])
  @@map("source_applications")
}

// ObservedEvent is the pre-decision layer — raw browser activity captured by the extension.
// Not every observed event becomes a formal decision; this is the signal stream.
// "User closed Jira ticket" → ObservedEvent. "Team approved 30% discount" → Decision.
model ObservedEvent {
  id                    String   @id @default(uuid()) @db.Uuid
  clientId              Int      @map("client_id")
  sourceApp             String   @map("source_app") @db.Text
  sourceApplicationId   String?  @map("source_application_id") @db.Uuid
  eventType             String   @map("event_type") @db.Text
  sourceUrl             String?  @map("source_url") @db.Text
  externalEntityId      String?  @map("external_entity_id") @db.Text
  title                 String?  @db.Text
  description           String?  @db.Text
  occurredByUserId      Int?     @map("occurred_by_user_id")
  rawPayload            Json?    @map("raw_payload")
  metadata              Json?    @default("{}")
  convertedToDecisionId String?  @map("converted_to_decision_id") @db.Uuid
  occurredAt            DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceApplication SourceApplication? @relation(fields: [sourceApplicationId], references: [id], onDelete: SetNull)
  occurredBy        User?              @relation(fields: [occurredByUserId], references: [id], onDelete: SetNull)
  decision          Decision?          @relation(fields: [convertedToDecisionId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([sourceApp])
  @@index([eventType])
  @@index([occurredAt])
  @@index([clientId, sourceApp])
  @@index([convertedToDecisionId])
  @@map("observed_events")
}

// DecisionNote is append-only commentary — informal human reasoning attached to a decision.
// Captures the "customer was frustrated after the outage" context that never makes it into
// formal approval fields.
model DecisionNote {
  id         String   @id @default(uuid()) @db.Uuid
  decisionId String   @map("decision_id") @db.Uuid
  authorId   Int?     @map("author_id")
  content    String   @db.Text
  sourceApp  String?  @map("source_app") @db.Text
  sourceUrl  String?  @map("source_url") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([decisionId])
  @@index([authorId])
  @@map("decision_notes")
}

// DecisionEntity links a decision to any external artifact — Jira tickets, Figma files,
// GitHub PRs, Salesforce opportunities — without requiring schema changes per integration.
model DecisionEntity {
  id         String   @id @default(uuid()) @db.Uuid
  decisionId String   @map("decision_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.Text
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([entityType, entityId])
  @@map("decision_entities")
}

// ============================================================
// AI DECISION REPORTS
// ============================================================

// AIDecisionReport is generated on-demand per client + context category.
// It compiles all decisions in that category into a decision.md document
// that can be fed into any AI tool as organisational context/memory.
model AIDecisionReport {
  id            String         @id @default(uuid()) @db.Uuid
  clientId      Int            @map("client_id")
  categoryId    String         @map("category_id") @db.Uuid
  title         String?        @db.Text
  content       String?        @db.Text // compiled decision.md markdown
  status        AIReportStatus @default(PENDING)
  decisionCount Int?           @map("decision_count")
  agentModel    String?        @map("agent_model")
  triggeredBy   Int?           @map("triggered_by")
  generatedAt   DateTime?      @map("generated_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  client          Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category        ClientContextCategory @relation(fields: [categoryId], references: [id])
  triggeredByUser User?                 @relation(fields: [triggeredBy], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([clientId, categoryId])
  @@index([status])
  @@map("ai_decision_reports")
}

enum AIReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED

  @@map("ai_report_status")
}

// ============================================================
// CLIENT-SCOPED DECISION TYPES
// ============================================================

// ClientDecisionType replaces the DecisionType enum.
// Reserved types (DISCOUNT, ONBOARDING, etc.) are seeded automatically
// via DB trigger on client creation. Clients can add custom types where
// isReserved = false.
model ClientDecisionType {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     Int      @map("client_id")
  decisionType String   @map("decision_type") @db.VarChar(100)
  label        String?  @db.Text
  isReserved   Boolean  @default(false) @map("is_reserved")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  decisions Decision[]

  @@unique([clientId, decisionType])
  @@index([clientId])
  @@map("client_decision_types")
}

// ============================================================
// CLIENT-SCOPED CONTEXT CATEGORIES
// ============================================================

// ClientContextCategory replaces the ContextCategory enum.
// Reserved categories (PAYMENT, HIRING, etc.) are seeded automatically
// via DB trigger on client creation. Clients can add custom categories
// where isReserved = false.
model ClientContextCategory {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  Int      @map("client_id")
  category  String   @db.VarChar(100)
  label     String?  @db.Text
  isReserved Boolean @default(false) @map("is_reserved")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  decisions         Decision[]
  aiDecisionReports AIDecisionReport[]

  @@unique([clientId, category])
  @@index([clientId])
  @@map("client_context_categories")
}
